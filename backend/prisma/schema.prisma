// Prisma Schema for Manufacturing ERP (Case Study 2)
// Primary Business Workflow: Customer Enquiry -> Quotation -> Accepted Quotation -> Sales Order -> Inventory Reservation -> Dispatch

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

// ==========================================
// User & Authentication (RBAC)
// ==========================================
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  role         Role          @default(SALES)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relationships
  enquiries    Enquiry[]
  quotations   Quotation[]
  salesOrders  SalesOrder[]  @relation("ConfirmedBy")
  cancelledOrders SalesOrder[] @relation("CancelledBy")
  dispatches   Dispatch[]

  @@map("users")
}

// ==========================================
// Customer Master
// ==========================================
model Customer {
  id            String        @id @default(uuid())
  companyName   String        @map("company_name")
  contactPerson String        @map("contact_person")
  mobile        String
  email         String
  city          String
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relationships
  enquiries     Enquiry[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]

  @@map("customers")
}

// ==========================================
// Product Master
// ==========================================
model Product {
  id             String          @id @default(uuid())
  productCode    String          @unique @map("product_code")
  productName    String          @map("product_name")
  category       String
  unit           String          // e.g., PCS, SET, MTR
  basePrice      Decimal         @db.Decimal(12, 2) @map("base_price")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relationships
  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems  DispatchItem[]

  @@map("products")
}

// ==========================================
// Inventory Management (1:1 with Product)
// ==========================================
// Available Quantity = physicalQuantity - reservedQuantity (- damagedQuantity)
model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique @map("product_id")
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  physicalQuantity Int      @default(0) @map("physical_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  damagedQuantity  Int      @default(0) @map("damaged_quantity") // Ready for Change 1 requirement
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("inventories")
}

// ==========================================
// Enquiry & Enquiry Items
// ==========================================
model Enquiry {
  id            String         @id @default(uuid())
  enquiryNumber String         @unique @map("enquiry_number")
  customerId    String         @map("customer_id")
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiryDate   DateTime       @default(now()) @map("enquiry_date")
  requiredDate  DateTime       @map("required_date")
  notes         String?
  status        EnquiryStatus  @default(NEW)
  createdById   String         @map("created_by_id")
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relationships
  items         EnquiryItem[]
  quotations    Quotation[]

  @@map("enquiries")
}

model EnquiryItem {
  id        String   @id @default(uuid())
  enquiryId String   @map("enquiry_id")
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("enquiry_items")
}

// ==========================================
// Quotation & Quotation Items
// ==========================================
model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique @map("quotation_number")
  enquiryId       String          @map("enquiry_id")
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customerId      String          @map("customer_id")
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  validUntil      DateTime        @map("valid_until")
  subtotal        Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2) @map("discount_amount")
  gstAmount       Decimal         @default(0) @db.Decimal(12, 2) @map("gst_amount")
  grandTotal      Decimal         @db.Decimal(12, 2) @map("grand_total")
  status          QuotationStatus @default(DRAFT)
  createdById     String          @map("created_by_id")
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relationships
  items           QuotationItem[]
  salesOrder      SalesOrder?

  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2) @map("unit_price")
  discountPct Decimal   @default(0) @db.Decimal(5, 2) @map("discount_pct")
  gstPct      Decimal   @default(18.00) @db.Decimal(5, 2) @map("gst_pct")
  lineAmount  Decimal   @db.Decimal(12, 2) @map("line_amount")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("quotation_items")
}

// ==========================================
// Sales Order & Order Items
// ==========================================
model SalesOrder {
  id            String           @id @default(uuid())
  orderNumber   String           @unique @map("order_number")
  customerId    String           @map("customer_id")
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // CRITICAL: Unique constraint on quotationId prevents duplicate Sales Orders from same quotation at the DB engine level!
  quotationId   String           @unique @map("quotation_id")
  quotation     Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  orderDate     DateTime         @default(now()) @map("order_date")
  totalAmount   Decimal          @db.Decimal(12, 2) @map("total_amount")
  status        SalesOrderStatus @default(PENDING)
  confirmedById String?          @map("confirmed_by_id")
  confirmedBy   User?            @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledById String?          @map("cancelled_by_id")
  cancelledBy   User?            @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relationships
  items         SalesOrderItem[]
  dispatch      Dispatch?

  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2) @map("unit_price")
  lineAmount   Decimal    @db.Decimal(12, 2) @map("line_amount")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("sales_order_items")
}

// ==========================================
// Dispatch & Dispatch Items
// ==========================================
model Dispatch {
  id             String         @id @default(uuid())
  dispatchNumber String         @unique @map("dispatch_number")
  // CRITICAL: Unique on salesOrderId prevents duplicate dispatch of same order at DB level!
  salesOrderId   String         @unique @map("sales_order_id")
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatchDate   DateTime       @default(now()) @map("dispatch_date")
  vehicleNumber  String         @map("vehicle_number")
  driverName     String         @map("driver_name")
  notes          String?
  dispatchedById String         @map("dispatched_by_id")
  dispatchedBy   User           @relation(fields: [dispatchedById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relationships
  items          DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String   @map("dispatch_id")
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("dispatch_items")
}
